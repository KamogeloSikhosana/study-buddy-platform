generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------
// Models
// -------------------------------

model Admins {
  admin_id Int    @id @default(autoincrement())
  email    String @unique(map: "Admin_email_key")
  password String
}

model Students {
  student_id    Int           @id @default(autoincrement())
  name          String
  surname       String
  email         String        @unique(map: "Student_email_key")
  address       String?
  profile_image String?
  bio           String?
  university    String?
  yos           String?
  course        String?
  password      String
  created_at    DateTime      @default(now())
  
  study_groups  StudyGroups[] // Groups they own
  group_members GroupMembers[] // Groups they're members of
}

model StudyGroups {
  group_id         Int       @id @default(autoincrement())
  user_id          Int
  group_name       String
  module_name      String
  about            String?
  num_members      Int
  meeting_platform String?
  meeting_link     String?
  meeting_date     DateTime
  meeting_time     String
  created_at       DateTime  @default(now())

  student          Students  @relation(fields: [user_id], references: [student_id], map: "StudyGroup_user_id_fkey")
  members          GroupMembers[]

  @@index([user_id], map: "StudyGroup_user_id_fkey")
}

model GroupMembers {
  member_id  Int       @id @default(autoincrement())
  group_id   Int
  student_id Int
  joined_at  DateTime  @default(now())

  group   StudyGroups @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  student Students    @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([group_id, student_id])
  @@map("group_members")
}