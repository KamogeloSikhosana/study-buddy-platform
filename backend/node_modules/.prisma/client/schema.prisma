generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SessionMembers {
  member_id  Int            @id @default(autoincrement())
  session_id Int?
  student_id Int?
  joined_at  DateTime?
  session    StudySessions? @relation(fields: [session_id], references: [session_id], onDelete: Cascade, map: "group_members_group_id_fkey")
  student    Students?      @relation(fields: [student_id], references: [student_id], onDelete: Cascade, map: "group_members_student_id_fkey")

  @@unique([session_id, student_id], map: "group_members_group_id_student_id_key")
  @@index([student_id], map: "group_members_student_id_fkey")
  @@map("session_members")
}

model Students {
  student_id      Int              @id @default(autoincrement())
  name            String
  surname         String
  email           String           @unique(map: "Student_email_key")
  address         String?
  profile_image   String?
  bio             String?
  university      String?
  yos             String?
  course          String?
  password        String
  created_at      DateTime         @default(now())
  resources       Resource[]
  session_members SessionMembers[]
  study_sessions  StudySessions[]
  tasks           tasks[]
  posts           Posts[] // Add this line
  comments        Comments[] // Add this line
  post_likes      PostLikes[] // Add this line
  comment_likes   CommentLikes[] // Add this line

  @@map("students")
}

model StudySessions {
  session_id       Int              @id @default(autoincrement())
  student_id       Int?
  group_name       String
  module_name      String
  about            String?
  num_members      Int
  meeting_platform String?
  meeting_link     String?
  meeting_date     DateTime
  meeting_time     String
  created_at       DateTime         @default(now())
  resources        Resource[]
  members          SessionMembers[]
  student          Students?        @relation(fields: [student_id], references: [student_id], onDelete: Restrict, map: "StudyGroup_user_id_fkey")

  @@index([student_id], map: "StudyGroup_user_id_fkey")
  @@map("study_sessions")
}

model Resource {
  resource_id Int            @id @default(autoincrement())
  student_id  Int
  session_id  Int?
  file_name   String         @db.VarChar(255)
  file_path   String         @db.VarChar(255)
  file_type   String         @db.VarChar(10)
  description String?        @db.Text
  uploaded_at DateTime?      @default(now()) @db.DateTime(0)
  student     Students       @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction, map: "resources_ibfk_1")
  session     StudySessions? @relation(fields: [session_id], references: [session_id], onDelete: NoAction, onUpdate: NoAction, map: "resources_ibfk_2")

  @@index([session_id], map: "session_id")
  @@index([student_id], map: "student_id")
  @@map("resources")
}

model admins {
  admin_id Int    @id @default(autoincrement())
  email    String @unique(map: "Admin_email_key")
  password String
}

model tasks {
  task_id     Int             @id @default(autoincrement())
  student_id  Int
  title       String          @db.VarChar(255)
  type        tasks_type?     @default(TASK)
  priority    tasks_priority? @default(MEDIUM)
  date        DateTime        @db.DateTime(0)
  time        String          @db.VarChar(10)
  description String?         @db.Text
  completed   Boolean?        @default(false)
  created_at  DateTime?       @default(now()) @db.Timestamp(0)
  updated_at  DateTime?       @default(now()) @db.Timestamp(0)
  students    Students        @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_ibfk_1")

  @@index([student_id], map: "student_id")
}

enum tasks_type {
  TASK
  MEETING
  CALLBACK
}

enum tasks_priority {
  LOW
  MEDIUM
  HIGH
}

model Posts {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  content    String   @db.Text
  image_url  String?  @db.VarChar(500)
  student_id Int
  post_type  String   @default("question") @db.VarChar(50)
  status     String   @default("published") @db.VarChar(20)
  likes      Int      @default(0)
  views      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  student    Students    @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  comments   Comments[]
  post_likes PostLikes[]

  @@map("posts")
}

model Comments {
  id         Int      @id @default(autoincrement())
  post_id    Int
  student_id Int
  content    String   @db.Text
  likes      Int      @default(0)
  created_at DateTime @default(now())

  post          Posts          @relation(fields: [post_id], references: [id], onDelete: Cascade)
  student       Students       @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  comment_likes CommentLikes[]

  @@map("comments")
}

model PostLikes {
  id         Int      @id @default(autoincrement())
  post_id    Int
  student_id Int
  created_at DateTime @default(now())

  post    Posts    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  student Students @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([post_id, student_id])
  @@map("post_likes")
}

model CommentLikes {
  id         Int      @id @default(autoincrement())
  comment_id Int
  student_id Int
  created_at DateTime @default(now())

  comment Comments @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  student Students @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([comment_id, student_id])
  @@map("comment_likes")
}
