generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------
// MODELS
// -------------------------------

model Admins {
  admin_id Int    @id @default(autoincrement())
  email    String @unique(map: "Admin_email_key")
  password String
}

model SessionMembers {
  member_id  Int      @id @default(autoincrement())
  session_id Int
  student_id Int
  joined_at  DateTime @default(now())

  session StudySessions @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  student Students      @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@map("session_members")
}

model Students {
  student_id    Int      @id @default(autoincrement())
  name          String
  surname       String
  email         String   @unique(map: "Student_email_key")
  address       String?
  profile_image String?
  bio           String?
  university    String?
  yos           String?
  course        String?
  password      String
  created_at    DateTime @default(now())

  study_sessions  StudySessions[] // Sessions created by the student
  session_members SessionMembers[] // Sessions the student has joined
  resources       Resource[] // <-- add this
}

model StudySessions {
  session_id       Int      @id @default(autoincrement())
  student_id       Int
  group_name       String
  module_name      String
  about            String?
  num_members      Int
  meeting_platform String?
  meeting_link     String?
  meeting_date     DateTime
  meeting_time     String
  created_at       DateTime @default(now())

  student   Students         @relation(fields: [student_id], references: [student_id], map: "StudySession_student_id_fkey")
  members   SessionMembers[]
  resources Resource[] // <-- add this

  @@index([student_id], map: "StudySession_student_id_fkey")
  @@map("study_sessions")
}

model Resource {
  resource_id Int      @id @default(autoincrement())
  student_id  Int
  session_id  Int?
  file_name   String
  file_path   String
  file_type   String
  description String?
  uploaded_at DateTime @default(now())

  student Students       @relation(fields: [student_id], references: [student_id])
  session StudySessions? @relation(fields: [session_id], references: [session_id])

  @@map("resources")
}
